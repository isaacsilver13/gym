# Local development defaults to a SQLite file in the repo root.
# Production uses a Postgres URL, e.g. postgresql+psycopg://user:pass@host/db?sslmode=require
DATABASE_URL=sqlite:///./gym_tracker_dev.db

# "development" enables permissive CORS for the Vite dev server and allows
# non-HTTPS session cookies. Any other value tightens both.
APP_ENV=development

# Signs session cookies. Outside APP_ENV=development the app refuses to start unless this is
# set to a random value of 32+ characters (e.g. `python -c "import secrets; print(secrets.token_urlsafe(48))"`).
# The value below is a development-only fallback and is rejected in production.
SESSION_SECRET=dev-only-insecure-secret

# Optional. Enables GET /api/v1/health/errors via the X-Admin-Token header. Unset = endpoint disabled.
# ADMIN_TOKEN=

# Optional. Enables GET /api/v1/assistant/summary (read-only progress for one user, used by
# the AIsaac dashboard) via the X-Assistant-Token header. Either unset = endpoint returns 404.
# ASSISTANT_READ_TOKEN=
# ASSISTANT_USERNAME=

# Combined training overview: exact local owner; unset disables upstream access.
# TRAINING_USERNAME=
# TRAINING_TIMEZONE=America/Chicago
# OPENGYM_URL=https://gym.example.com
# OPENGYM_PUBLIC_URL=https://gym.example.com
# OPENGYM_UID=
# OPENGYM_TOKEN=
# ENDURAIN_URL=https://runs.example.com
# ENDURAIN_PUBLIC_URL=https://runs.example.com
# ENDURAIN_USER_ID=
# ENDURAIN_TOKEN_FILE=/private/connections/endurain.json
# Endurain read APIs use a mobile JWT session, not its upload-only API key.

# Dedicated Apple Health receiver, disabled unless explicitly configured.
# APPLE_HEALTH_CONFIG_FILE=/private/connections/apple-health.json
# APPLE_HEALTH_QUEUE=/data/apple-health.sqlite
