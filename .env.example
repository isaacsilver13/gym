# Local development defaults to a SQLite file in the repo root.
# Production uses a Postgres URL, e.g. postgresql+psycopg://user:pass@host/db?sslmode=require
DATABASE_URL=sqlite:///./gym_tracker_dev.db

# "development" enables permissive CORS for the Vite dev server and allows
# non-HTTPS session cookies. Any other value tightens both.
APP_ENV=development

# Signs session cookies. Outside APP_ENV=development the app refuses to start unless this is
# set to a random value of 32+ characters (e.g. `python -c "import secrets; print(secrets.token_urlsafe(48))"`).
# The value below is a development-only fallback and is rejected in production.
SESSION_SECRET=dev-only-insecure-secret

# Optional. Enables GET /api/v1/health/errors via the X-Admin-Token header. Unset = endpoint disabled.
# ADMIN_TOKEN=
